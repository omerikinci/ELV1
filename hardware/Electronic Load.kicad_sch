				(size 1.27 1.27)
			)
		)
		(uuid "06460c33-f325-4978-873d-9d6175d94494")
	)
	(text "You don't need to use an oscillator;\nthe STM32's internal oscillator is sufficient for this project."
		(exclude_from_sim no)
		(at 436.88 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "077d0e63-f033-42af-8f32-9f3855767fd3")
	)
	(text "Do not use PWM; simply turn it on or off-do not\n leave it partially on, as this causes the op-amps to oscillate."
		(exclude_from_sim no)
		(at 118.11 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3dab194f-e742-4cf2-a70f-7aa4bcdeeff8")
	)
