	(text "When applying voltage to the protected input, ensure that the voltage is 8 V or higher, as the protection MOSFETs will not fully turn on.\nA voltage between 0 and 30 V can be applied to the unprotected input."
		(exclude_from_sim no)
		(at 464.82 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ee2e0996-0cde-48bf-ab2f-88e907c2f9d6")
	)
